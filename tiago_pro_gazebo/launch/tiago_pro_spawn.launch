<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="gzpose" default="-x 0 -y 0 -z 0.0 -R 0.0 -P 0.0 -Y 0.0"/>
  <arg name="model_name" default="tiago_pro"/>

 <rosparam ns="pal_robot_info" subst_value="true">
    type: "tiago_pro"
    end_effector_left: "pal-pro-gripper"
    end_effector_right: "pal-pro-gripper"
    robot_camera_frame: "head_d435_camera_color_optical_frame"
    base_type: "omni_base"
  </rosparam>

  <!-- PID gains -->
  <rosparam command="load" file="$(find tiago_pro_gazebo)/config/pids.yaml"/>
  <rosparam command="load" file="$(find tiago_pro_gazebo)/config/hardware_gazebo/tiago_pro_pal_hardware_gazebo.yaml"/>

  <!-- Robot model -->
  <include file="$(find tiago_pro_description)/robots/upload.launch"/>  

  <!-- Spawn robot in Gazebo -->
  <node pkg="gazebo_ros" type="spawn_model" name="spawn_model"
    args="-urdf -param robot_description $(arg gzpose) -model $(arg model_name)" />

</launch>
