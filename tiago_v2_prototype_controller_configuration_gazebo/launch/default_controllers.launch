<?xml version="1.0" encoding="UTF-8"?>
<launch>

  <rosparam command="load" file="$(find tiago_v2_prototype_controller_configuration)/config/joint_trajectory_controllers.yaml" />
  <rosparam command="load" file="$(find tiago_v2_prototype_controller_configuration_gazebo)/config/mobile_base_controller.yaml" />
  <rosparam command="load" file="$(find joint_state_controller)/joint_state_controller.yaml" />

  <param name="mobile_base_controller/base_frame_id" value="/base_footprint"/>
  <param name="mobile_base_controller/odom_frame_id" value="/odom"/>

  <!-- Set up controllers -->
  <arg name="controller_list"
       value="joint_state_controller
              torso_controller
              arm_left_controller
              arm_right_controller
              mobile_base_controller"/>

  <!-- Controllers that come up started -->
  <node name="default_controllers_spawner"
        pkg="controller_manager" type="spawner" output="screen"
        args="--timeout 120
             $(arg controller_list) " />

</launch>
